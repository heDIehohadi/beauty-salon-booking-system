# Copy to backend/beautysalon/.env (ignored by Git) and load it into the
# shell before running Django:
#   set -a; source .env; set +a
# Django does not read .env files by itself.

# Development (default when nothing is set): DJANGO_DEBUG=true
# Production: DJANGO_DEBUG=false and a long random DJANGO_SECRET_KEY, e.g.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
# Comma-separated host names, e.g. example.com,www.example.com
DJANGO_ALLOWED_HOSTS=
